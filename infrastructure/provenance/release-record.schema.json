{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dutch release provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactDigest", "sourceRevision", "builtAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sourceRevision": { "type": "string", "minLength": 7 },
    "builtAt": { "type": "string", "format": "date-time" },
    "workflowRunUrl": { "type": "string", "format": "uri" }
  }
}
