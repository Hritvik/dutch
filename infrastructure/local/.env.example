# Local-only placeholders. Generate distinct values, keep them out of source control.
DUTCH_LOCAL_POSTGRES_SUPERUSER_PASSWORD=<set-in-local-env>
DUTCH_LOCAL_IAM_MIGRATION_PASSWORD=<set-in-local-env>
DUTCH_LOCAL_IAM_RUNTIME_PASSWORD=<set-in-local-env>
DUTCH_LOCAL_UMS_MIGRATION_PASSWORD=<set-in-local-env>
DUTCH_LOCAL_UMS_RUNTIME_PASSWORD=<set-in-local-env>
DUTCH_LOCAL_LEDGER_MIGRATION_PASSWORD=<set-in-local-env>
DUTCH_LOCAL_LEDGER_RUNTIME_PASSWORD=<set-in-local-env>
DUTCH_LOCAL_NOTIFICATION_MIGRATION_PASSWORD=<set-in-local-env>
DUTCH_LOCAL_NOTIFICATION_RUNTIME_PASSWORD=<set-in-local-env>

# Gateway runtime endpoints (no secrets)
GATEWAY_IAM_ISSUER_URI=http://localhost:8081
GATEWAY_UMS_BASE_URL=http://localhost:8082
GATEWAY_LEDGER_BASE_URL=http://localhost:8083
